{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "skullking-game-server",
  "main": "index.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name":"ROOMS","class_name":"SkullRoom"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["SkullRoom"]}],
  "vars": {"ALLOWED_ORIGINS":"https://aboutpis-skullking.pages.dev,http://localhost:5173,http://127.0.0.1:5173,http://terminal.local:4173"},
  "observability": {"enabled":false}
}
